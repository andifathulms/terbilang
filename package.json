{
  "name": "terbilang",
  "version": "0.0.0",
  "description": "Bilangan Indonesia ke kata dan kembali lagi. Dua arah, BigInt, tanpa dependensi.",
  "license": "MIT",
  "author": "Andi Fathul Mukminin Salahuddin",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "terbilang",
    "indonesia",
    "number-to-words",
    "kwitansi",
    "rupiah",
    "bigint"
  ],
  "scripts": {
    "build:lib": "tsup",
    "build": "next build && node scripts/postbuild.mjs",
    "build:size": "node scripts/check-bundle-size.mjs",
    "dev": "next dev",
    "preview": "node scripts/preview.mjs",
    "test": "vitest",
    "test:run": "vitest run --exclude tests/exhaustive/**",
    "test:exhaustive": "vitest run tests/exhaustive",
    "test:bigint": "vitest run tests/boundaries/bigint.test.ts",
    "survey:record": "tsx scripts/survey-record.ts",
    "typecheck": "tsc --noEmit",
    "lint": "next lint"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "next": "^14.2.5",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.6",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^2.0.3"
  },
  "packageManager": "pnpm@9.15.9"
}
